# Copy to .env.staging or .env.production; do not overwrite local development env.
# Each environment needs a separate Neon endpoint/role and independently generated secrets.
APP_ENV="staging"
DATABASE_URL="postgresql://APP_ROLE:PASSWORD@ep-STAGING-pooler.REGION.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://MIGRATION_ROLE:PASSWORD@ep-STAGING.REGION.neon.tech/neondb?sslmode=require"
# Pin the direct hostname chosen for this environment (no credentials).
DEPLOYMENT_DB_HOST="ep-STAGING.REGION.neon.tech"
AUTH_URL="https://STAGING_DOMAIN"
AUTH_SECRET=""
AUTH_RATE_LIMIT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_AUTH_VERSION="1"
MAIL_PAYLOAD_KEY=""
RESEND_API_KEY=""
RESEND_FROM=""
CRON_SECRET=""
# Read-only monitoring credential, distinct from Cron and login secrets.
OPS_SECRET=""
