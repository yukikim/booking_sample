# Local Docker Compose only. Do not use these credentials for a hosted database.
# Copy to .env only if .env does not already exist.
DATABASE_URL="postgresql://booking:booking_local_password@127.0.0.1:5432/booking_sample?schema=public"
DIRECT_URL="postgresql://booking:booking_local_password@127.0.0.1:5432/booking_sample?schema=public"

# Task 3.1.1: fill locally; never commit actual secrets.
# Generate AUTH_SECRET and AUTH_RATE_LIMIT_SECRET independently (32+ random bytes).
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_RATE_LIMIT_SECRET=""
# Administrator login and recipient of member reservation confirmations and cancellations.
ADMIN_EMAIL=""
# 15–128 Unicode code points. Keep leading/trailing spaces if intentional.
ADMIN_PASSWORD=""
# Increment whenever administrator credentials change; restart every instance.
ADMIN_AUTH_VERSION="1"

# Task 3.3: 32 random bytes in base64, independent of AUTH_SECRET.
MAIL_PAYLOAD_KEY=""
# Resend delivery: `npm run mail:send` for a manual batch; `/api/cron/mail` for scheduled batches.
# Use a send-enabled verified domain for recipients outside Resend's test addresses.
RESEND_API_KEY=""
RESEND_FROM=""
# 16+ random characters; Vercel Cron sends this as a Bearer token.
CRON_SECRET=""

# Story 7.2: read-only /api/ops/health credential (32+ random characters).
OPS_SECRET=""
# Hosted environment template: .env.hosted.example; never use local URLs there.
