{
  "name": "booking_sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "check": "npm run db:validate && npm run db:generate && npm run lint && npm run typecheck && npm test",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:migrate": "node --import tsx scripts/migrate-local.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test:db": "node --conditions=react-server --import tsx scripts/verify-database.ts",
    "test:auth": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "test:member": "node --conditions=react-server --import tsx scripts/verify-member.ts",
    "test:booking": "node --conditions=react-server --import tsx scripts/verify-booking.ts",
    "test:withdrawal": "node --conditions=react-server --import tsx scripts/verify-withdrawal.ts",
    "test:e2e:http": "npm run test:auth && npm run test:member && npm run test:booking && npm run test:withdrawal",
    "check:release": "npm run check && npm run test:db && npm run test:e2e:http && npm run build",
    "mail:send": "node --conditions=react-server --import tsx scripts/send-member-mail.ts",
    "mail:check-domain": "node --import tsx scripts/check-mail-domain.ts",
    "env:check": "node --import tsx scripts/check-deployment-env.ts",
    "build:deploy": "npm run env:check && npm run db:generate && npm run build",
    "db:backup": "node --import tsx scripts/backup-database.ts",
    "test:recovery": "node --conditions=react-server --import tsx scripts/verify-recovery.ts",
    "smoke:deployment": "node --import tsx scripts/smoke-deployment.ts",
    "db:deployment": "node --import tsx scripts/deploy-database.ts",
    "db:backup:local": "node --import tsx scripts/backup-local-database.ts",
    "db:import:production": "node --import tsx scripts/import-production-database.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.30.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vercel": "62.1.0"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.4"
    },
    "vercel@62.1.0": {
      "smol-toml": "1.9.0",
      "undici": "6.29.0"
    },
    "@vercel/static-config@3.4.4": {
      "ajv": "8.20.0"
    },
    "@vercel/python-analysis@0.14.0": {
      "js-yaml": "4.3.2",
      "minimatch": "10.2.6",
      "smol-toml": "1.9.0"
    },
    "@vercel/backends@12.0.0": {
      "path-to-regexp": "8.4.2",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2"
    },
    "@vercel/express@12.0.0": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/hono@12.0.0": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/node@17.0.0": {
      "path-to-regexp": "6.3.0",
      "undici": "6.29.0"
    },
    "@vercel/remix-builder@17.0.0": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/container@12.0.0": {
      "smol-toml": "1.9.0",
      "tar": "7.5.22"
    },
    "@vercel/rust@13.0.0": {
      "smol-toml": "1.9.0"
    }
  }
}
