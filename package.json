{
  "name": "booking_sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "check": "npm run db:validate && npm run db:generate && npm run lint && npm run typecheck && npm test",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:migrate": "node --import tsx scripts/migrate-local.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test:db": "node --conditions=react-server --import tsx scripts/verify-database.ts",
    "test:auth": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "test:member": "node --conditions=react-server --import tsx scripts/verify-member.ts",
    "test:booking": "node --conditions=react-server --import tsx scripts/verify-booking.ts",
    "test:withdrawal": "node --conditions=react-server --import tsx scripts/verify-withdrawal.ts",
    "test:e2e:http": "npm run test:auth && npm run test:member && npm run test:booking && npm run test:withdrawal",
    "check:release": "npm run check && npm run test:db && npm run test:e2e:http && npm run build",
    "mail:send": "node --conditions=react-server --import tsx scripts/send-member-mail.ts",
    "mail:check-domain": "node --import tsx scripts/check-mail-domain.ts"
  },
  "dependencies": {
    "@next/env": "16.3.5",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.30.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.4"
    }
  }
}
